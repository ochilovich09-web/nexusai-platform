PORT=8787
JWT_SECRET=change-me-in-production-please-32-chars-min
CLIENT_ORIGIN=http://localhost:5173

# --- Ma'lumotlar bazasi ---
# Bo'sh bo'lsa: lokal SQLite fayli (server/data/nexusai.db).
# To'ldirilsa: Turso (bulut libSQL) — Vercel kabi serverless muhitlar uchun majburiy.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Lokal faylning papkasini o'zgartirish (host volume uchun):
# DATA_DIR=/data

# --- AI provayder (bittasini to'ldiring; bo'sh bo'lsa "demo" rejim ishlaydi) ---
# DIQQAT: bu fayl namuna. Haqiqiy kalitni faqat server/.env ichiga yozing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# low | minimal | high — Gemini 3 ichki fikrlash darajasi
GEMINI_THINKING_LEVEL=low

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
